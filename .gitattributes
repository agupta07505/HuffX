# Auto detect text files and perform LF normalization
* text=auto

# Ensure Windows batch files always retain CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Standardize LF line endings for cross-platform code
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
